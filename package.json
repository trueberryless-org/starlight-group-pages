{
  "name": "starlight-group-pages-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Starlight plugin to give your sidebar groups their own pages.",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter starlight-group-pages-docs build",
    "check": "pnpm --filter starlight-group-pages-docs astro sync && astro check --noSync",
    "dev": "pnpm --filter starlight-group-pages-docs dev",
    "format": "prettier . --write --cache --ignore-unknown",
    "preview": "pnpm --filter starlight-group-pages-docs preview",
    "test": "pnpm --filter starlight-group-pages test",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "astro": "^7.3.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "homepage": "https://starlight-group-pages.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trueberryless-org/starlight-group-pages.git"
  },
  "bugs": "https://github.com/trueberryless-org/starlight-group-pages/issues"
}
