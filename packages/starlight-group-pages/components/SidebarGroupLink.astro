---
import { Badge } from "@astrojs/starlight/components";

import { type SidebarGroup, getGroupLabelLink } from "../libs/sidebar";

interface Props {
  group: SidebarGroup;
}

const { group } = Astro.props;

const link = getGroupLabelLink(group);
---

{link && (
  <a
    href={link.href}
    aria-current={link.isCurrent ? "page" : undefined}
    class="sl-group-pages-link"
  >
    <span>{group.label}</span>
    {group.badge && (
      <Badge
        variant={group.badge.variant}
        class={group.badge.class}
        text={group.badge.text}
      />
    )}
  </a>
)}

<script>
  // Starlight only persists the open state of groups toggled with their `<summary>`, so a group opened by clicking its
  // label link would collapse again when navigating to a page outside of it. This mirrors Starlight's
  // `SidebarPersistState` script to persist the group as open instead.
  const storageKey = "sl-sidebar-state";

  document
    .getElementById("starlight__sidebar")
    ?.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest(".sl-group-pages-link");
      const restoreElement = link?.parentElement?.querySelector(
        ":scope > details > sl-sidebar-restore"
      );
      const index = Number.parseInt(
        restoreElement instanceof HTMLElement
          ? (restoreElement.dataset["index"] ?? "")
          : ""
      );
      if (Number.isNaN(index)) return;

      persistOpenGroup(index);
    });

  function persistOpenGroup(index: number) {
    try {
      const hash =
        document.querySelector<HTMLElement>("sl-sidebar-state-persist")
          ?.dataset["hash"] ?? "";
      const storedState = JSON.parse(
        sessionStorage.getItem(storageKey) ?? "{}"
      );
      const state =
        storedState.hash === hash && Array.isArray(storedState.open)
          ? storedState
          : { hash, open: [], scroll: 0 };

      state.open[index] = true;
      sessionStorage.setItem(storageKey, JSON.stringify(state));
    } catch {
      // Like Starlight, persisting the sidebar state is a progressive enhancement.
    }
  }
</script>

<style>
  @layer starlight.core {
    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      margin-inline-end: var(--sl-group-pages-toggle-size);
      padding-block: 0.2em;
      padding-inline: var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    a:hover,
    a:focus-visible {
      background-color: var(--sl-color-hairline-light);
    }

    [aria-current="page"],
    [aria-current="page"]:hover,
    [aria-current="page"]:focus {
      color: var(--sl-color-text-invert);
      background-color: var(--sl-color-text-accent);
    }

    a > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    @media (min-width: 50rem) {
      a {
        font-size: var(--sl-text-base);
      }
    }
  }
</style>
